# Compiled class files (run.cmd / test.cmd compile into out/)
*.class
*.jar
out/

# BlueJ files (BlueJ regenerates these when the folder is opened)
*.ctxt
package.bluej

# Game saves / leaderboard (Java-serialized, local to each player)
highscores.dat
leaderboard.dat

# Logs
*.log

# IDE folders
.idea/
*.iml
.vscode/

# OS files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store

# Rendered art (made locally by tools/blender/build_scenes.py; not stored in git)
resources/scenes/
resources/images/

# Downloaded Poly Haven assets (CC0; fetched by tools/blender/fetch_assets.py)
tools/blender/assets/

# Python bytecode from the Blender scripts
__pycache__/
resources/board/

# Godot engine binary and the editor's import cache (local)
tools/godot/
godot/.godot/
godot/assets/
mask_concepts.png
storybook_preview.png
pixel_preview.png
